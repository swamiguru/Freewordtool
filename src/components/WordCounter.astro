---
export interface Props {
  heading?: string;
}
const { heading = "Word Counter" } = Astro.props;
---

<div class="flex flex-col min-h-screen">
  <!-- Header -->
  <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <svg class="w-8 h-8 text-blue-600" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="4" width="28" height="24" rx="3" fill="currentColor" opacity="0.15"/>
            <rect x="6" y="9" width="12" height="2" rx="1" fill="currentColor"/>
            <rect x="6" y="14" width="20" height="2" rx="1" fill="currentColor"/>
            <rect x="6" y="19" width="16" height="2" rx="1" fill="currentColor"/>
          </svg>
        </a>
        <nav class="hidden md:flex items-center gap-4 ml-4 text-sm">
          <a href="/character-counter" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
          <a href="/words-to-pages" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
          <a href="/reading-time-calculator" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
          <a href="/essay-word-counter" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
          <a href="/lorem-ipsum-generator" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
          <a href="/features" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
        </nav>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
        >
          <svg id="icon-sun" class="w-5 h-5 hidden dark:block text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.07-.71.71M6.34 17.66l-.71.71m12.73 0-.71-.71M6.34 6.34l-.71-.71M12 5a7 7 0 1 1 0 14A7 7 0 0 1 12 5z"/>
          </svg>
          <svg id="icon-moon" class="w-5 h-5 block dark:hidden text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
          </svg>
        </button>
        <button id="mobile-menu-btn" aria-label="Toggle menu" class="md:hidden p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
          <svg id="hamburger-icon" class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-5 h-5 text-gray-600 dark:text-gray-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
      <nav class="flex flex-col px-4 py-3 gap-1 text-sm">
        <a href="/" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Word Counter</a>
        <a href="/character-counter" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Features</a>
      </nav>
    </div>
  </header>

  <!-- Hero Title -->
  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-900 dark:to-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">{heading}</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm">Type or paste text below to instantly count words, characters, sentences, and more.</p>
    </div>
  </div>

  <!-- Main Tool Area -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-4 py-6">
    <!-- Character Limit Bar -->
    <div class="mb-4 p-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 shrink-0">Character limit:</span>
        <span id="limit-status" class="hidden text-xs font-semibold ml-auto shrink-0"></span>
      </div>
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-hide">
        <button data-limit="0"    class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">Off</button>
        <button data-limit="60"   class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">Email Subject (60)</button>
        <button data-limit="80"   class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">TikTok Bio (80)</button>
        <button data-limit="160"  class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">Meta Description (160)</button>
        <button data-limit="280"  class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">Twitter (280)</button>
        <button data-limit="500"  class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">Pinterest (500)</button>
        <button data-limit="2200" class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">Instagram (2200)</button>
        <button data-limit="3000" class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">LinkedIn (3000)</button>
        <button data-limit="5000" class="limit-btn shrink-0 px-3 py-1 text-xs rounded-full border border-gray-300 dark:border-gray-600 hover:border-blue-500 hover:text-blue-600 transition-colors bg-white dark:bg-gray-800">YouTube Desc (5000)</button>
      </div>
      <div id="limit-bar-container" class="hidden mt-2">
        <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 mb-1">
          <span id="limit-chars-used">0</span>
          <span id="limit-chars-max">/ 280</span>
        </div>
        <div class="w-full h-2 rounded-full bg-gray-200 dark:bg-gray-700">
          <div id="limit-bar" class="h-2 rounded-full bg-blue-500 transition-all duration-200" style="width:0%"></div>
        </div>
      </div>
    </div>

    <!-- Editor + Stats -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <!-- Textarea -->
      <div class="lg:col-span-2 flex flex-col">
        <!-- Writing Analysis toggle -->
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <div class="relative">
                <input id="analysis-toggle" type="checkbox" class="sr-only peer" />
                <div class="w-9 h-5 rounded-full bg-gray-300 dark:bg-gray-600 peer-checked:bg-blue-600 transition-colors"></div>
                <div class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"></div>
              </div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Writing Analysis</span>
            </label>
            <button id="lorem-fill" class="text-xs px-2.5 py-1 rounded-md border border-gray-200 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Try Lorem Ipsum</button>
            <div id="analysis-legend" class="hidden items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
              <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm bg-yellow-200"></span>20–30 words</span>
              <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm bg-red-200"></span>30+ words</span>
              <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm border-b-2 border-blue-500"></span>Passive</span>
            </div>
          </div>
        </div>

        <div class="relative">
          <!-- Highlight overlay -->
          <div
            id="analysis-overlay"
            aria-hidden="true"
            class="hidden absolute inset-0 p-4 text-base leading-relaxed rounded-xl pointer-events-none overflow-hidden font-sans text-transparent whitespace-pre-wrap break-words"
          ></div>
          <textarea
            id="text-input"
            placeholder="Start typing or paste your text here…"
            spellcheck="true"
            class="relative w-full h-80 lg:h-[520px] p-4 text-base leading-relaxed rounded-xl border-2 border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-600 resize-none focus:outline-none focus:border-blue-500 dark:focus:border-blue-500 transition-colors font-sans"
          ></textarea>
          <button
            id="clear-btn"
            class="absolute top-3 right-3 p-1.5 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950 transition-colors opacity-0"
            aria-label="Clear text"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
          <!-- Draft saved badge -->
          <div id="draft-badge" class="absolute bottom-3 left-3 px-2 py-1 rounded-md bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 text-xs font-medium opacity-0 transition-opacity duration-500 pointer-events-none">
            Draft saved
          </div>
        </div>

        <!-- Copy / Download — immediately below textarea -->
        <div class="mt-2 flex gap-4 px-1">
          <button id="copy-btn" class="flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span id="copy-btn-label">Copy text</span>
          </button>
          <button id="download-btn" class="flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Download .txt
          </button>
        </div>

        <!-- Analysis summary bar -->
        <div id="analysis-bar" class="hidden mt-2 px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-xs text-gray-600 dark:text-gray-400 flex items-center gap-3 flex-wrap">
          <span id="analysis-long" class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-sm bg-yellow-300 inline-block"></span>
            <span id="long-count">0</span> long sentences
          </span>
          <span class="text-gray-300 dark:text-gray-600">·</span>
          <span id="analysis-vlong" class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-sm bg-red-300 inline-block"></span>
            <span id="vlong-count">0</span> very long sentences
          </span>
          <span class="text-gray-300 dark:text-gray-600">·</span>
          <span class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-sm border-b-2 border-blue-500 inline-block"></span>
            <span id="passive-count">0</span> passive voice
          </span>
        </div>
      </div>

      <!-- Stats Panel -->
      <div class="flex flex-col gap-3">
        <!-- Word Goal -->
        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
          <label for="word-goal" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2 block">Word Goal</label>
          <input
            id="word-goal"
            type="number"
            min="1"
            placeholder="Set a word goal…"
            class="w-full px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors"
          />
          <div id="goal-container" class="hidden mt-3">
            <div class="w-full h-2.5 rounded-full bg-gray-200 dark:bg-gray-700">
              <div id="goal-bar" class="h-2.5 rounded-full bg-blue-500 transition-all duration-300" style="width:0%"></div>
            </div>
            <p id="goal-label" class="text-xs text-gray-500 dark:text-gray-400 mt-1.5 text-right">0 / 0 words</p>
          </div>
        </div>

        <!-- Primary stats -->
        <div class="grid grid-cols-2 gap-3">
          <div class="stat-card p-4 rounded-xl bg-blue-600 text-white shadow-sm">
            <div id="stat-words" class="text-3xl font-bold">0</div>
            <div class="text-xs text-blue-200 mt-0.5 uppercase tracking-wide">Words</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-indigo-600 text-white shadow-sm">
            <div id="stat-chars" class="text-3xl font-bold">0</div>
            <div class="text-xs text-indigo-200 mt-0.5 uppercase tracking-wide">Characters</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-gray-100 dark:bg-gray-800 shadow-sm">
            <div id="stat-chars-no-space" class="text-3xl font-bold text-gray-800 dark:text-white">0</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 uppercase tracking-wide">No Spaces</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-gray-100 dark:bg-gray-800 shadow-sm">
            <div id="stat-sentences" class="text-3xl font-bold text-gray-800 dark:text-white">0</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 uppercase tracking-wide">Sentences</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-gray-100 dark:bg-gray-800 shadow-sm">
            <div id="stat-paragraphs" class="text-3xl font-bold text-gray-800 dark:text-white">0</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 uppercase tracking-wide">Paragraphs</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-gray-100 dark:bg-gray-800 shadow-sm">
            <div id="stat-lines" class="text-3xl font-bold text-gray-800 dark:text-white">0</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 uppercase tracking-wide">Lines</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-gray-100 dark:bg-gray-800 shadow-sm">
            <div id="stat-unique" class="text-3xl font-bold text-gray-800 dark:text-white">0</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 uppercase tracking-wide">Unique Words</div>
          </div>
          <div class="stat-card p-4 rounded-xl bg-gray-100 dark:bg-gray-800 shadow-sm">
            <div id="stat-vocab" class="text-3xl font-bold text-gray-800 dark:text-white">0%</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 uppercase tracking-wide">Vocab Richness</div>
          </div>
        </div>

        <!-- Reading/Speaking Time -->
        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Time Estimates</h2>
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <span class="text-sm text-gray-600 dark:text-gray-400">Reading time</span>
              </div>
              <span id="stat-read-time" class="text-sm font-semibold text-gray-800 dark:text-white">0 sec</span>
            </div>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                </svg>
                <span class="text-sm text-gray-600 dark:text-gray-400">Speaking time</span>
              </div>
              <span id="stat-speak-time" class="text-sm font-semibold text-gray-800 dark:text-white">0 sec</span>
            </div>
          </div>
        </div>

        <!-- Readability -->
        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Readability</h2>
          <div class="flex flex-col gap-4">

            <!-- Flesch Reading Ease -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-gray-600 dark:text-gray-400">Flesch Reading Ease</span>
                <span id="flesch-score" class="text-xs font-bold text-gray-800 dark:text-white">—</span>
              </div>
              <div class="w-full h-2 rounded-full bg-gray-200 dark:bg-gray-700">
                <div id="flesch-bar" class="h-2 rounded-full transition-all duration-300 bg-blue-500" style="width:0%"></div>
              </div>
              <p id="flesch-label" class="text-xs text-gray-400 dark:text-gray-500 mt-1">Enter text to score</p>
            </div>

            <!-- Flesch-Kincaid Grade -->
            <div class="flex items-center justify-between">
              <span class="text-xs text-gray-600 dark:text-gray-400">Flesch-Kincaid Grade</span>
              <span id="fk-grade" class="text-xs font-bold text-gray-800 dark:text-white">—</span>
            </div>

            <!-- Gunning Fog -->
            <div class="flex items-center justify-between">
              <span class="text-xs text-gray-600 dark:text-gray-400">Gunning Fog Index</span>
              <span id="fog-score" class="text-xs font-bold text-gray-800 dark:text-white">—</span>
            </div>

          </div>
        </div>

        <!-- Top Keywords -->
        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 flex-1">
          <!-- Tabs -->
          <div class="flex gap-1 mb-3">
            <button id="tab-words" class="kw-tab active-tab px-2.5 py-1 text-xs rounded-md font-medium transition-colors">Words</button>
            <button id="tab-bigrams" class="kw-tab px-2.5 py-1 text-xs rounded-md font-medium transition-colors">2-Word Phrases</button>
          </div>
          <!-- Column headers -->
          <div class="grid grid-cols-[1fr_auto_auto] gap-x-2 mb-1.5 px-0.5">
            <span class="text-xs text-gray-400 dark:text-gray-500">Keyword</span>
            <span class="text-xs text-gray-400 dark:text-gray-500 text-right">Count</span>
            <span class="text-xs text-gray-400 dark:text-gray-500 text-right">Density</span>
          </div>
          <!-- Words panel -->
          <div id="keyword-list" class="flex flex-col gap-1.5">
            <p class="text-xs text-gray-400 dark:text-gray-600 italic col-span-3">Start typing to see keywords…</p>
          </div>
          <!-- Bigrams panel -->
          <div id="bigram-list" class="hidden flex flex-col gap-1.5">
            <p class="text-xs text-gray-400 dark:text-gray-600 italic">Start typing to see phrases…</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<style>
  .stat-card { transition: transform 0.1s ease; }
  .stat-card:hover { transform: translateY(-1px); }
  .limit-btn.active {
    background-color: rgb(37 99 235);
    color: white;
    border-color: rgb(37 99 235);
  }
  #text-input.over-limit {
    border-color: rgb(239 68 68) !important;
  }
  #draft-badge.show {
    opacity: 1;
  }
  .kw-tab {
    color: rgb(107 114 128);
    background: transparent;
  }
  .kw-tab:hover {
    color: rgb(37 99 235);
  }
  .kw-tab.active-tab {
    background-color: rgb(37 99 235);
    color: white;
  }
  /* Hide scrollbar on chip row but keep scroll */
  .scrollbar-hide { scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }

  /* Writing analysis overlay — must exactly match textarea geometry */
  #analysis-overlay {
    top: 0; left: 0; right: 0; bottom: 0;
    color: transparent;
    background: transparent;
    z-index: 1;
    word-wrap: break-word;
    overflow-y: auto;
  }
  #text-input.analysis-on {
    background: transparent !important;
    position: relative;
    z-index: 2;
    caret-color: inherit;
  }
  /* The textarea sits on top of the overlay; make it semi-transparent so highlights show through */
  #text-input.analysis-on {
    background: transparent !important;
  }
  .wa-long    { background: rgba(253,224,71,0.55);  border-radius: 2px; }
  .wa-vlong   { background: rgba(252,165,165,0.6);  border-radius: 2px; }
  .wa-passive { text-decoration: underline; text-decoration-color: #3b82f6; text-decoration-thickness: 2px; text-underline-offset: 2px; }
</style>

<script>
const STOP_WORDS = new Set([
  'a','an','the','and','or','but','in','on','at','to','for','of','with','by',
  'from','is','it','its','was','are','were','be','been','being','have','has',
  'had','do','does','did','will','would','could','should','may','might','shall',
  'not','no','nor','so','yet','both','either','neither','as','if','then','than',
  'that','this','these','those','i','me','my','we','our','you','your','he','she',
  'him','her','they','them','their','us','who','what','which','when','where','why',
  'how','all','any','each','few','more','most','other','some','such','into','up',
  'out','about','after','before','during','between','through','over','under','also',
  'just','because','while','although','however','therefore','there','here','can',
  'get','got','use','make','like','go','know','take','see','come','think','look',
  'want','give','back','new','old','s','re','t','ll','ve','d','m'
]);

function formatTime(minutes) {
  if (minutes < 1) {
    const secs = Math.round(minutes * 60);
    return secs <= 0 ? '0 sec' : `${secs} sec`;
  }
  const mins = Math.floor(minutes);
  const secs = Math.round((minutes - mins) * 60);
  if (secs === 0) return `${mins} min`;
  return `${mins} min ${secs} sec`;
}

function countWords(text) {
  const trimmed = text.trim();
  if (!trimmed) return 0;
  return trimmed.split(/\s+/).filter(w => w.length > 0).length;
}

function countSentences(text) {
  const trimmed = text.trim();
  if (!trimmed) return 0;
  const matches = trimmed.match(/[^.!?]*[.!?]+/g);
  return matches ? matches.length : (trimmed.length > 0 ? 1 : 0);
}

function countParagraphs(text) {
  const trimmed = text.trim();
  if (!trimmed) return 0;
  return trimmed.split(/\n\s*\n/).filter(p => p.trim().length > 0).length;
}

function countLines(text) {
  if (!text.trim()) return 0;
  return text.split('\n').filter(l => l.trim().length > 0).length;
}

function getKeywords(text) {
  const words = text.toLowerCase().match(/\b[a-z]{3,}\b/g) || [];
  const nonStop = words.filter(w => !STOP_WORDS.has(w));
  const total = nonStop.length;
  const freq = {};
  for (const w of nonStop) freq[w] = (freq[w] || 0) + 1;
  return Object.entries(freq)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([word, count]) => ({ word, count, density: total ? (count / total * 100).toFixed(1) : '0.0' }));
}

function getBigrams(text) {
  const words = text.toLowerCase().match(/\b[a-z]{2,}\b/g) || [];
  const nonStop = [];
  // Keep all words but track positions to form bigrams from adjacent non-stop content words
  // Build bigrams from original word sequence (include stops for adjacency, filter stop-stop pairs)
  const freq = {};
  for (let i = 0; i < words.length - 1; i++) {
    const a = words[i], b = words[i + 1];
    if (STOP_WORDS.has(a) && STOP_WORDS.has(b)) continue;
    const bigram = `${a} ${b}`;
    freq[bigram] = (freq[bigram] || 0) + 1;
  }
  const total = Object.values(freq).reduce((s, v) => s + v, 0) || 1;
  return Object.entries(freq)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([phrase, count]) => ({ word: phrase, count, density: (count / total * 100).toFixed(1) }));
}

function countSyllables(word) {
  word = word.toLowerCase().replace(/[^a-z]/g, '');
  if (!word) return 0;
  // Silent e
  word = word.replace(/e$/, '');
  const vowelGroups = word.match(/[aeiouy]+/g);
  return Math.max(1, vowelGroups ? vowelGroups.length : 1);
}

function readabilityStats(text) {
  const wordList = text.trim().match(/\b[a-zA-Z'-]+\b/g) || [];
  const wordCount = wordList.length;
  if (wordCount === 0) return null;

  const sentenceCount = Math.max(1, countSentences(text));
  const totalSyllables = wordList.reduce((sum, w) => sum + countSyllables(w), 0);
  const complexWords = wordList.filter(w => countSyllables(w) >= 3).length;

  const avgWordsPerSentence = wordCount / sentenceCount;
  const avgSyllablesPerWord = totalSyllables / wordCount;
  const pctComplex = (complexWords / wordCount) * 100;

  const flesch = Math.round(
    206.835 - (1.015 * avgWordsPerSentence) - (84.6 * avgSyllablesPerWord)
  );
  const fkGrade = Math.max(0,
    (0.39 * avgWordsPerSentence) + (11.8 * avgSyllablesPerWord) - 15.59
  ).toFixed(1);
  const fog = (0.4 * (avgWordsPerSentence + pctComplex)).toFixed(1);

  return { flesch: Math.min(100, Math.max(0, flesch)), fkGrade, fog };
}

function fleschLabel(score) {
  if (score >= 90) return { text: 'Very Easy', color: 'bg-green-500' };
  if (score >= 70) return { text: 'Standard',  color: 'bg-blue-500' };
  if (score >= 50) return { text: 'Difficult',  color: 'bg-yellow-500' };
  return                   { text: 'Very Confusing', color: 'bg-red-500' };
}

function updateReadability(text) {
  const stats = readabilityStats(text);
  const scoreEl = document.getElementById('flesch-score');
  const barEl   = document.getElementById('flesch-bar');
  const labelEl = document.getElementById('flesch-label');
  const fkEl    = document.getElementById('fk-grade');
  const fogEl   = document.getElementById('fog-score');

  if (!stats) {
    scoreEl.textContent = '—';
    barEl.style.width = '0%';
    labelEl.textContent = 'Enter text to score';
    fkEl.textContent = '—';
    fogEl.textContent = '—';
    return;
  }

  const { flesch, fkGrade, fog } = stats;
  const { text: lText, color } = fleschLabel(flesch);

  scoreEl.textContent = flesch;
  barEl.style.width = flesch + '%';
  barEl.className = `h-2 rounded-full transition-all duration-300 ${color}`;
  labelEl.textContent = lText;
  fkEl.textContent = `Grade ${fkGrade}`;
  fogEl.textContent = fog;
}

// ── Writing Analysis ─────────────────────────────────────────────────────────
const PASSIVE_RE = /\b(am|is|are|was|were|be|been|being)\s+\w+ed\b/gi;

function splitSentences(text) {
  // Split on sentence-ending punctuation, keeping the delimiter with the sentence
  return text.match(/[^.!?]*[.!?]+[\s]*/g) || (text.trim() ? [text] : []);
}

function wordCount(str) {
  return (str.trim().match(/\S+/g) || []).length;
}

function buildOverlay(text) {
  // We need to annotate spans in the raw text preserving all whitespace
  // Strategy: iterate sentence by sentence, within each apply passive highlighting
  let longCount = 0, vlongCount = 0;
  const passiveMatches = [];

  // Collect all passive matches across full text for counting
  let pm;
  PASSIVE_RE.lastIndex = 0;
  while ((pm = PASSIVE_RE.exec(text)) !== null) passiveMatches.push({ start: pm.index, end: pm.index + pm[0].length, text: pm[0] });

  // Build char-level annotation map: 'l'=long, 'v'=vlong, 'p'=passive (can stack)
  const sentMark  = new Uint8Array(text.length); // 1=long,2=vlong
  const passiveMark = new Uint8Array(text.length); // 1=passive

  // Sentence boundaries
  let cursor = 0;
  const sentenceRe = /[^.!?]*[.!?]+/g;
  let sm;
  sentenceRe.lastIndex = 0;
  while ((sm = sentenceRe.exec(text)) !== null) {
    const wc = wordCount(sm[0]);
    if (wc > 30) { vlongCount++; for (let i = sm.index; i < sm.index + sm[0].length; i++) sentMark[i] = 2; }
    else if (wc >= 20) { longCount++; for (let i = sm.index; i < sm.index + sm[0].length; i++) sentMark[i] = 1; }
    cursor = sm.index + sm[0].length;
  }
  // Handle trailing text with no punctuation
  if (cursor < text.length) {
    const tail = text.slice(cursor);
    const wc = wordCount(tail);
    if (wc > 30)      { vlongCount++; for (let i = cursor; i < text.length; i++) sentMark[i] = 2; }
    else if (wc >= 20){ longCount++;  for (let i = cursor; i < text.length; i++) sentMark[i] = 1; }
  }

  // Passive marks
  for (const { start, end } of passiveMatches) for (let i = start; i < end; i++) passiveMark[i] = 1;

  // Build HTML — walk character by character, emit spans on mark changes
  let html = '';
  let i = 0;
  while (i < text.length) {
    const sm2 = sentMark[i], pm2 = passiveMark[i];
    // Find run length where marks don't change
    let j = i + 1;
    while (j < text.length && sentMark[j] === sm2 && passiveMark[j] === pm2) j++;
    const chunk = text.slice(i, j).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const cls = [sm2 === 2 ? 'wa-vlong' : sm2 === 1 ? 'wa-long' : '', pm2 ? 'wa-passive' : ''].filter(Boolean).join(' ');
    html += cls ? `<span class="${cls}">${chunk}</span>` : chunk;
    i = j;
  }
  return { html, longCount, vlongCount, passiveCount: passiveMatches.length };
}

let analysisOn = false;

function updateAnalysis(text) {
  const overlay = document.getElementById('analysis-overlay');
  const bar     = document.getElementById('analysis-bar');
  const legend  = document.getElementById('analysis-legend');
  const ta      = document.getElementById('text-input');

  if (!analysisOn || !text.trim()) {
    overlay.classList.add('hidden');
    bar.classList.add('hidden');
    legend.classList.add('hidden');
    ta.classList.remove('analysis-on');
    return;
  }

  const { html, longCount, vlongCount, passiveCount } = buildOverlay(text);
  overlay.innerHTML = html;
  overlay.scrollTop = ta.scrollTop;

  overlay.classList.remove('hidden');
  bar.classList.remove('hidden');
  legend.classList.remove('flex');
  legend.classList.add('flex');
  legend.classList.remove('hidden');
  ta.classList.add('analysis-on');

  document.getElementById('long-count').textContent  = longCount;
  document.getElementById('vlong-count').textContent = vlongCount;
  document.getElementById('passive-count').textContent = passiveCount;
}
// ─────────────────────────────────────────────────────────────────────────────

let charLimit = 0;
let draftBadgeTimer = null;

function showDraftBadge() {
  const badge = document.getElementById('draft-badge');
  badge.classList.add('show');
  clearTimeout(draftBadgeTimer);
  draftBadgeTimer = setTimeout(() => badge.classList.remove('show'), 2000);
}

function updateGoal(words) {
  const input = document.getElementById('word-goal');
  const goal = parseInt(input.value, 10);
  const container = document.getElementById('goal-container');
  if (!goal || goal <= 0) {
    container.classList.add('hidden');
    return;
  }
  container.classList.remove('hidden');
  const pct = Math.min((words / goal) * 100, 100);
  const reached = words >= goal;
  const bar = document.getElementById('goal-bar');
  bar.style.width = pct + '%';
  bar.className = `h-2.5 rounded-full transition-all duration-300 ${reached ? 'bg-green-500' : 'bg-blue-500'}`;
  document.getElementById('goal-label').textContent = `${words.toLocaleString()} / ${goal.toLocaleString()} words`;
}

function updateStats() {
  const text = document.getElementById('text-input').value;
  const words = countWords(text);
  const chars = text.length;
  const charsNoSpace = text.replace(/\s/g, '').length;

  // Unique words & vocab richness
  const allWords = text.toLowerCase().match(/\b[a-z']+\b/g) || [];
  const uniqueWords = new Set(allWords).size;
  const vocabRichness = allWords.length > 0 ? Math.round((uniqueWords / allWords.length) * 100) : 0;

  document.getElementById('stat-words').textContent = words.toLocaleString();
  document.getElementById('stat-chars').textContent = chars.toLocaleString();
  document.getElementById('stat-chars-no-space').textContent = charsNoSpace.toLocaleString();
  document.getElementById('stat-sentences').textContent = countSentences(text).toLocaleString();
  document.getElementById('stat-paragraphs').textContent = countParagraphs(text).toLocaleString();
  document.getElementById('stat-lines').textContent = countLines(text).toLocaleString();
  document.getElementById('stat-unique').textContent = uniqueWords.toLocaleString();
  document.getElementById('stat-vocab').textContent = vocabRichness + '%';
  document.getElementById('stat-read-time').textContent = formatTime(words / 238);
  document.getElementById('stat-speak-time').textContent = formatTime(words / 130);

  // Keywords & Bigrams
  const keywords = getKeywords(text);
  const bigrams  = getBigrams(text);

  function renderRows(items, emptyMsg) {
    if (items.length === 0) return `<p class="text-xs text-gray-400 dark:text-gray-600 italic">${emptyMsg}</p>`;
    const maxCount = items[0].count;
    return items.map(({ word, count, density }) => {
      const pct = Math.round((count / maxCount) * 100);
      return `<div>
        <div class="grid grid-cols-[1fr_auto_auto] gap-x-2 items-center mb-0.5">
          <span class="text-xs font-medium text-gray-700 dark:text-gray-300 truncate capitalize">${word}</span>
          <span class="text-xs text-gray-500 dark:text-gray-400 text-right tabular-nums">${count}</span>
          <span class="text-xs text-blue-600 dark:text-blue-400 text-right tabular-nums w-10">${density}%</span>
        </div>
        <div class="w-full h-1.5 rounded-full bg-gray-200 dark:bg-gray-700">
          <div class="h-1.5 rounded-full bg-blue-500 transition-all duration-300" style="width:${pct}%"></div>
        </div>
      </div>`;
    }).join('');
  }

  document.getElementById('keyword-list').innerHTML = renderRows(keywords, 'Start typing to see keywords…');
  document.getElementById('bigram-list').innerHTML  = renderRows(bigrams,  'Start typing to see phrases…');

  // Limit bar
  if (charLimit > 0) {
    const pct = Math.min((chars / charLimit) * 100, 100);
    const over = chars > charLimit;
    document.getElementById('limit-chars-used').textContent = chars.toLocaleString();
    const bar = document.getElementById('limit-bar');
    bar.style.width = pct + '%';
    bar.className = `h-2 rounded-full transition-all duration-200 ${over ? 'bg-red-500' : pct > 80 ? 'bg-yellow-500' : 'bg-blue-500'}`;
    const ta = document.getElementById('text-input');
    if (over) {
      ta.classList.add('over-limit');
    } else {
      ta.classList.remove('over-limit');
    }
    const status = document.getElementById('limit-status');
    if (over) {
      status.textContent = `${(chars - charLimit).toLocaleString()} over limit`;
      status.className = 'text-xs font-semibold text-red-600 dark:text-red-400';
      status.classList.remove('hidden');
    } else {
      const remaining = charLimit - chars;
      status.textContent = `${remaining.toLocaleString()} left`;
      status.className = 'text-xs font-semibold text-green-600 dark:text-green-400';
      status.classList.remove('hidden');
    }
  } else {
    document.getElementById('text-input').classList.remove('over-limit');
    document.getElementById('limit-status').classList.add('hidden');
  }

  // Readability
  updateReadability(text);

  // Writing analysis
  updateAnalysis(text);

  // Word goal
  updateGoal(words);

  // Clear btn visibility
  const clearBtn = document.getElementById('clear-btn');
  if (text.length > 0) {
    clearBtn.classList.remove('opacity-0');
  } else {
    clearBtn.classList.add('opacity-0');
  }
}

// Writing analysis toggle
document.getElementById('analysis-toggle').addEventListener('change', (e) => {
  analysisOn = e.target.checked;
  updateAnalysis(document.getElementById('text-input').value);
});

// ── Lorem Ipsum fill ─────────────────────────────────────────────────────────
const LOREM_WORDS = ['lorem','ipsum','dolor','sit','amet','consectetur','adipiscing','elit','sed','do','eiusmod','tempor','incididunt','ut','labore','et','dolore','magna','aliqua','enim','ad','minim','veniam','quis','nostrud','exercitation','ullamco','laboris','nisi','aliquip','ex','ea','commodo','consequat','duis','aute','irure','in','reprehenderit','voluptate','velit','esse','cillum','fugiat','nulla','pariatur','excepteur','sint','occaecat','cupidatat','non','proident','sunt','culpa','qui','officia','deserunt','mollit','anim','id','est','laborum','pellentesque','habitant','morbi','tristique','senectus','netus','malesuada','fames','turpis','egestas','volutpat','ac','sapien','viverra','curabitur','bibendum','arcu','elementum','nunc','justo','fermentum','iaculis','euismod','purus','feugiat','nisl','pretium','fusce','tortor','suspendisse','potenti','nullam'];
function loremSentence() {
  const len = 8 + Math.floor(Math.random() * 10);
  const words = Array.from({length: len}, () => LOREM_WORDS[Math.floor(Math.random() * LOREM_WORDS.length)]);
  words[0] = words[0].charAt(0).toUpperCase() + words[0].slice(1);
  return words.join(' ') + '.';
}
function loremParagraph() {
  return Array.from({length: 4 + Math.floor(Math.random() * 3)}, loremSentence).join(' ');
}
document.getElementById('lorem-fill')?.addEventListener('click', () => {
  const ta = document.getElementById('text-input');
  const classic = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.';
  const paras = [classic + ' ' + loremParagraph(), loremParagraph(), loremParagraph()];
  ta.value = paras.join('\n\n');
  ta.dispatchEvent(new Event('input'));
});

// Mirror scroll position from textarea to overlay
document.getElementById('text-input').addEventListener('scroll', () => {
  const ta = document.getElementById('text-input');
  const overlay = document.getElementById('analysis-overlay');
  overlay.scrollTop = ta.scrollTop;
});

// Keyword tabs
document.getElementById('tab-words').addEventListener('click', () => {
  document.getElementById('keyword-list').classList.remove('hidden');
  document.getElementById('bigram-list').classList.add('hidden');
  document.getElementById('tab-words').classList.add('active-tab');
  document.getElementById('tab-bigrams').classList.remove('active-tab');
});
document.getElementById('tab-bigrams').addEventListener('click', () => {
  document.getElementById('bigram-list').classList.remove('hidden');
  document.getElementById('keyword-list').classList.add('hidden');
  document.getElementById('tab-bigrams').classList.add('active-tab');
  document.getElementById('tab-words').classList.remove('active-tab');
});

// Auto-save to localStorage
document.getElementById('text-input').addEventListener('input', () => {
  const text = document.getElementById('text-input').value;
  localStorage.setItem('wc-autosave', text);
  showDraftBadge();
  updateStats();
});

// Restore draft on page load
const saved = localStorage.getItem('wc-autosave');
if (saved) {
  document.getElementById('text-input').value = saved;
}

// Word goal input
document.getElementById('word-goal').addEventListener('input', () => {
  const words = countWords(document.getElementById('text-input').value);
  updateGoal(words);
});

// Clear btn
document.getElementById('clear-btn').addEventListener('click', () => {
  document.getElementById('text-input').value = '';
  updateStats();
});

// Copy btn
document.getElementById('copy-btn').addEventListener('click', async () => {
  const text = document.getElementById('text-input').value;
  if (!text) return;
  await navigator.clipboard.writeText(text);
  const label = document.getElementById('copy-btn-label');
  label.textContent = 'Copied!';
  setTimeout(() => { label.textContent = 'Copy text'; }, 2000);
});

// Download btn
document.getElementById('download-btn').addEventListener('click', () => {
  const text = document.getElementById('text-input').value;
  if (!text) return;
  const blob = new Blob([text], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'wordcount-text.txt';
  a.click();
  URL.revokeObjectURL(url);
});

// Limit buttons
document.querySelectorAll('.limit-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    charLimit = parseInt(btn.dataset.limit || '0', 10);
    document.querySelectorAll('.limit-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const container = document.getElementById('limit-bar-container');
    if (charLimit > 0) {
      container.classList.remove('hidden');
      document.getElementById('limit-chars-max').textContent = `/ ${charLimit.toLocaleString()}`;
    } else {
      container.classList.add('hidden');
    }
    updateStats();
  });
});

// Theme toggle
document.getElementById('theme-toggle').addEventListener('click', () => {
  const isDark = document.documentElement.classList.toggle('dark');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
});

document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
  const menu = document.getElementById('mobile-menu');
  const burger = document.getElementById('hamburger-icon');
  const close  = document.getElementById('close-icon');
  menu?.classList.toggle('hidden');
  burger?.classList.toggle('hidden');
  close?.classList.toggle('hidden');
});

// Initial call
updateStats();
</script>
