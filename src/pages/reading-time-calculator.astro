---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "How is reading time calculated?",
    a: "Reading time is calculated by dividing the total word count by the average adult silent reading speed of 238 words per minute (wpm). This is based on academic research and is the same rate used by tools like Medium."
  },
  {
    q: "How is speaking time calculated?",
    a: "Speaking time is estimated at 130 words per minute, which represents a clear, natural conversational pace. Professional public speakers typically aim for 120–150 wpm, making 130 wpm a reliable middle estimate."
  },
  {
    q: "How long does it take to read 1,000 words?",
    a: "At the average reading speed of 238 wpm, 1,000 words takes approximately 4 minutes and 12 seconds to read silently. It would take about 7 minutes and 42 seconds to speak aloud at 130 wpm."
  },
  {
    q: "How long does it take to read 500 words?",
    a: "500 words takes approximately 2 minutes and 6 seconds to read at 238 wpm. For a speech or presentation, allow about 3 minutes and 51 seconds at 130 wpm."
  },
  {
    q: "How long does it take to read 2,000 words?",
    a: "2,000 words takes approximately 8 minutes and 24 seconds to read silently. As a spoken presentation at 130 wpm, 2,000 words runs about 15 minutes and 23 seconds."
  },
  {
    q: "What is the average adult reading speed?",
    a: "The average adult reads silently at approximately 200–250 words per minute. Our calculator uses 238 wpm as the standard estimate, based on published research. Skilled readers can reach 300–400 wpm; most children read at 100–150 wpm."
  },
  {
    q: "How long should a 5-minute speech be?",
    a: "At 130 words per minute, a 5-minute speech is approximately 650 words. At a faster pace of 150 wpm, a 5-minute speech is around 750 words. Always rehearse your actual delivery pace for accurate timing."
  },
  {
    q: "Can I use this for podcast or video scripts?",
    a: "Yes. For podcasts and video voiceover scripts, the speaking time estimate (130 wpm) is a solid baseline. TV news anchors speak at ~150 wpm, audiobook narrators at ~150–160 wpm. Adjust your expectation slightly upward for faster delivery styles."
  }
];

const referenceRows = [
  { words: 300,   read: '1 min 15 sec', speak: '2 min 18 sec' },
  { words: 500,   read: '2 min 6 sec',  speak: '3 min 51 sec' },
  { words: 750,   read: '3 min 9 sec',  speak: '5 min 46 sec' },
  { words: 1000,  read: '4 min 12 sec', speak: '7 min 42 sec' },
  { words: 1500,  read: '6 min 18 sec', speak: '11 min 32 sec' },
  { words: 2000,  read: '8 min 24 sec', speak: '15 min 23 sec' },
  { words: 2500,  read: '10 min 30 sec', speak: '19 min 13 sec' },
  { words: 5000,  read: '21 min',        speak: '38 min 27 sec' },
  { words: 10000, read: '42 min',        speak: '1 hr 16 min' },
];
---

<Layout
  title="Reading Time Calculator — How Long Does It Take to Read?"
  description="Calculate reading time and speaking time from word count. Instantly convert words to minutes for essays, speeches, blog posts, and presentations."
>
  <!-- Header -->
  <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <svg class="w-8 h-8 text-blue-600" viewBox="0 0 32 32" fill="currentColor">
            <rect x="2" y="4" width="28" height="24" rx="3" fill="currentColor" opacity="0.15"/>
            <rect x="6" y="9" width="12" height="2" rx="1" fill="currentColor"/>
            <rect x="6" y="14" width="20" height="2" rx="1" fill="currentColor"/>
            <rect x="6" y="19" width="16" height="2" rx="1" fill="currentColor"/>
          </svg>
          <span class="font-bold text-xl text-blue-600 group-hover:text-blue-700 transition-colors">Free Word Tool</span>
        </a>
        <nav class="hidden sm:flex items-center gap-4 ml-4 text-sm">
          <a href="/" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Word Counter</a>
          <a href="/character-counter" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
          <a href="/words-to-pages" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
          <a href="/reading-time-calculator" class="text-blue-600 dark:text-blue-400 font-medium">Reading Time</a>
        </nav>
      </div>
      <button id="theme-toggle" aria-label="Toggle dark mode" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
        <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.07-.71.71M6.34 17.66l-.71.71m12.73 0-.71-.71M6.34 6.34l-.71-.71M12 5a7 7 0 1 1 0 14A7 7 0 0 1 12 5z"/></svg>
        <svg class="w-5 h-5 block dark:hidden text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
      </button>
    </div>
  </header>

  <!-- Hero -->
  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-900 dark:to-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Reading Time Calculator</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-2 text-sm max-w-xl">Enter a word count to instantly calculate how long it will take to read or speak. Great for blog posts, essays, speeches, and presentations.</p>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 py-10">

    <!-- Calculator Card -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 p-6 mb-10 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Calculate Reading & Speaking Time</h2>
      <div class="flex flex-col sm:flex-row gap-4 mb-6">
        <div class="flex-1">
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1.5 uppercase tracking-wide">Word Count</label>
          <input
            id="rtc-words"
            type="number"
            min="1"
            placeholder="e.g. 1500"
            class="w-full px-3 py-2.5 rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>
        <div class="flex-1">
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1.5 uppercase tracking-wide">Reading Speed (optional)</label>
          <select id="rtc-speed" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:outline-none focus:border-blue-500 transition-colors">
            <option value="200">Slow reader — 200 wpm</option>
            <option value="238" selected>Average adult — 238 wpm</option>
            <option value="300">Fast reader — 300 wpm</option>
            <option value="400">Speed reader — 400 wpm</option>
          </select>
        </div>
      </div>

      <!-- Results -->
      <div id="rtc-result" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 p-5 text-center">
          <div class="text-3xl mb-1">📖</div>
          <p class="text-xs font-medium text-blue-600 dark:text-blue-400 uppercase tracking-wide mb-1">Reading Time</p>
          <p id="rtc-read-time" class="text-3xl font-bold text-blue-700 dark:text-blue-300">—</p>
          <p class="text-xs text-blue-500 dark:text-blue-400 mt-1">silent reading</p>
        </div>
        <div class="rounded-xl bg-purple-50 dark:bg-purple-950 border border-purple-200 dark:border-purple-800 p-5 text-center">
          <div class="text-3xl mb-1">🎤</div>
          <p class="text-xs font-medium text-purple-600 dark:text-purple-400 uppercase tracking-wide mb-1">Speaking Time</p>
          <p id="rtc-speak-time" class="text-3xl font-bold text-purple-700 dark:text-purple-300">—</p>
          <p class="text-xs text-purple-500 dark:text-purple-400 mt-1">at 130 wpm</p>
        </div>
      </div>
      <div id="rtc-placeholder" class="rounded-xl bg-gray-50 dark:bg-gray-800 border border-dashed border-gray-300 dark:border-gray-600 p-5 text-center text-sm text-gray-400 dark:text-gray-500">
        Enter a word count above to calculate reading and speaking time
      </div>
    </div>

    <!-- Reference Table -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Reading Time Reference Table</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Estimates at average adult reading speed (238 wpm) and speaking speed (130 wpm).</p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
              <th class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Word Count</th>
              <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">Reading Time</th>
              <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">Speaking Time</th>
            </tr>
          </thead>
          <tbody>
            {referenceRows.map((row, i) => (
              <tr class={`border-b border-gray-100 dark:border-gray-800 ${i % 2 === 0 ? 'bg-white dark:bg-gray-900' : 'bg-gray-50/50 dark:bg-gray-800/40'}`}>
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{row.words.toLocaleString()} words</td>
                <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.read}</td>
                <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.speak}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Frequently Asked Questions</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">Common questions about reading speed and speech timing.</p>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" open={i === 0}>
            <summary class="flex items-center justify-between p-5 cursor-pointer bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors list-none">
              <span class="font-medium text-gray-900 dark:text-white pr-4">{faq.q}</span>
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-3 bg-white dark:bg-gray-950 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-12">
    <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 <a href="https://www.builtbyswami.com/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">BuiltbySwami</a>. All rights reserved.</p>
      <nav class="flex gap-4 flex-wrap justify-center">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Word Counter</a>
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
      </nav>
    </div>
  </footer>

  <script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    function formatTime(minutes: number): string {
      const totalSecs = Math.round(minutes * 60);
      const mins = Math.floor(totalSecs / 60);
      const secs = totalSecs % 60;
      if (mins === 0) return `${secs} sec`;
      if (secs === 0) return `${mins} min`;
      return `${mins} min ${secs} sec`;
    }

    function calculate() {
      const words = parseInt((document.getElementById('rtc-words') as HTMLInputElement).value, 10);
      const wpm   = parseInt((document.getElementById('rtc-speed') as HTMLSelectElement).value, 10);
      const result = document.getElementById('rtc-result')!;
      const ph     = document.getElementById('rtc-placeholder')!;

      if (!words || words <= 0) {
        result.classList.add('hidden');
        ph.classList.remove('hidden');
        return;
      }

      const readMins  = words / wpm;
      const speakMins = words / 130;

      document.getElementById('rtc-read-time')!.textContent  = formatTime(readMins);
      document.getElementById('rtc-speak-time')!.textContent = formatTime(speakMins);

      result.classList.remove('hidden');
      ph.classList.add('hidden');
    }

    document.getElementById('rtc-words')?.addEventListener('input', calculate);
    document.getElementById('rtc-speed')?.addEventListener('change', calculate);
  </script>
</Layout>
