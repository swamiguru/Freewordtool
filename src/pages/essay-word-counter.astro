---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';

const faqs = [
  {
    q: "How many words is a standard essay?",
    a: "A standard five-paragraph essay is typically 500–800 words. High school essays usually run 500–1,000 words, while college essays and application responses are often 250–650 words. Academic papers and research essays typically range from 1,500 to 5,000+ words."
  },
  {
    q: "How many paragraphs is a 500-word essay?",
    a: "A 500-word essay typically contains 4–5 paragraphs: an introduction, two to three body paragraphs, and a conclusion. Each paragraph runs 75–125 words, with a topic sentence, supporting detail, and closing thought."
  },
  {
    q: "How long does it take to write a 1,000-word essay?",
    a: "For most students, writing a 1,000-word essay takes 2–4 hours including research, outlining, drafting, and editing. The actual typing takes 20–30 minutes at average speed; the thinking and structuring takes most of the time."
  },
  {
    q: "How many words is a college application essay?",
    a: "Most college application essays (Common App, UC prompts) have a 250–650 word limit. The Common App personal statement has a firm 650-word maximum. Supplemental essays are typically 150–300 words. Always aim to hit at least 90% of the allowed limit."
  },
  {
    q: "How many pages is a 1,000-word essay?",
    a: "A 1,000-word essay is approximately 4 pages double-spaced at 12pt font with standard 1-inch margins. Single-spaced, the same essay fits on 2 pages. Use our Words to Pages calculator for other sizes."
  },
  {
    q: "What is a good word count for a high school essay?",
    a: "Most high school essay assignments range from 500 to 1,500 words. Five-paragraph essays are usually 500–800 words. Persuasive essays, literary analyses, and research papers are typically 1,000–1,500 words unless your teacher specifies otherwise."
  },
  {
    q: "How many words should a thesis statement be?",
    a: "A thesis statement is typically one to two sentences, or 25–50 words. It should be concise and specific — clearly stating your argument or position without being vague or overly broad. Avoid thesis statements longer than two sentences."
  },
  {
    q: "How many words is a dissertation?",
    a: "An undergraduate dissertation is typically 8,000–15,000 words. A master's thesis usually runs 15,000–40,000 words. A doctoral dissertation ranges from 40,000 to 80,000 words depending on the field and institution."
  }
];

const essayTypes = [
  { name: "Short Answer", words: "150–250", pages: "½–1", notes: "College supplements, exam responses" },
  { name: "Five-Paragraph Essay", words: "500–800", pages: "2–3", notes: "Standard high school assignment" },
  { name: "College App Essay", words: "250–650", pages: "1–2.5", notes: "Common App, UC prompts" },
  { name: "High School Essay", words: "1,000–1,500", pages: "4–6", notes: "Literary analysis, persuasive essays" },
  { name: "College Essay", words: "1,500–3,000", pages: "6–12", notes: "Research papers, term papers" },
  { name: "Research Paper", words: "3,000–5,000", pages: "12–20", notes: "Academic / peer-reviewed" },
  { name: "Undergraduate Thesis", words: "8,000–15,000", pages: "32–60", notes: "Senior capstone" },
  { name: "Master's Thesis", words: "15,000–40,000", pages: "60–160", notes: "Postgraduate research" },
];
---

<Layout
  title="Essay Word Counter — Free Word Count Tool for Students"
  description="Free essay word counter for students. Track words, characters, sentences, and paragraphs in real time. Includes essay length reference table and FAQ."
>
  <WordCounter heading="Essay Word Counter" />

  <!-- Student intro section -->
  <section class="max-w-4xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Essay Word Count Guide for Students</h2>
    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-4">
      Use this free essay word counter to track your word count, character count, sentence count, and paragraphs in real time as you write or paste your essay. The tool also shows readability scores, estimated reading time, and keyword frequency — all useful when editing academic work.
    </p>
    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-8">
      Not sure if your essay is long enough — or too long? Use the reference table below to find the expected word count for your assignment type.
    </p>

    <!-- Essay length reference table -->
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Standard Essay Lengths by Type</h3>
    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700 mb-8">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
            <th class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Essay Type</th>
            <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">Word Count</th>
            <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">Pages (double-spaced)</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300 hidden sm:table-cell">Notes</th>
          </tr>
        </thead>
        <tbody>
          {essayTypes.map((row, i) => (
            <tr class={`border-b border-gray-100 dark:border-gray-800 ${i % 2 === 0 ? 'bg-white dark:bg-gray-900' : 'bg-gray-50/50 dark:bg-gray-800/40'}`}>
              <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{row.name}</td>
              <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.words}</td>
              <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.pages}</td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-500 text-xs hidden sm:table-cell">{row.notes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- FAQ -->
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Frequently Asked Questions</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">Common student questions about essay word counts and lengths.</p>
    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <details class="group border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" open={i === 0}>
          <summary class="flex items-center justify-between p-5 cursor-pointer bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors list-none">
            <span class="font-medium text-gray-900 dark:text-white pr-4">{faq.q}</span>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 pt-3 bg-white dark:bg-gray-950 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{faq.a}</div>
        </details>
      ))}
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-4">
    <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 BuiltbySwami. All rights reserved.</p>
      <nav class="flex gap-4 flex-wrap justify-center">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Word Counter</a>
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
      </nav>
    </div>
  </footer>
</Layout>
