---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';

const faqs = [
  {
    q: "How does Free Word Tool work?",
    a: "Free Word Tool analyzes your text in real-time as you type or paste it into the editor. It splits the text by whitespace to count words, and uses pattern matching to detect sentences, paragraphs, and other metrics—all instantly and entirely in your browser."
  },
  {
    q: "Does Free Word Tool count hyphenated words as one or two words?",
    a: "Hyphenated words (e.g., 'well-being') are counted as a single word, following standard word-processing conventions."
  },
  {
    q: "How is reading time calculated?",
    a: "Reading time is estimated by dividing the total word count by 238 words per minute, which is the average silent reading speed for adults according to research. Speaking time uses 130 words per minute, the typical conversational speaking rate."
  },
  {
    q: "What counts as a sentence?",
    a: "A sentence is counted each time the text contains a period (.), exclamation mark (!), or question mark (?). Multiple punctuation marks (e.g., '!!!') are treated as a single sentence ending."
  },
  {
    q: "What counts as a paragraph?",
    a: "A paragraph is a block of text separated by one or more blank lines. Single line breaks within a block are not treated as new paragraphs."
  },
  {
    q: "Are there any word or character limits?",
    a: "There are no limits on how much text you can analyze. Our tool handles everything from tweets to full novels. You can optionally enable a character limit preset (Twitter, LinkedIn, Meta Description) to track compliance."
  },
  {
    q: "What are stop words in the keyword frequency list?",
    a: "Stop words are common English words like 'the', 'and', 'is', 'in', etc. that carry little semantic meaning. The keyword frequency list excludes these to highlight the most meaningful and relevant words in your text."
  },
  {
    q: "Is my text stored or sent to a server?",
    a: "No. Your text never leaves your browser. All counting, analysis, and keyword detection happens locally using JavaScript. We have no servers processing your data, and nothing is saved or logged. See our Privacy Policy for details."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Word Tool",
  "url": "https://www.freewordtool.com/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "description": "Free online tool to count words, characters, sentences, and paragraphs instantly. Includes reading time, readability scores, keyword frequency, and a Lorem Ipsum generator.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<Layout title="Free Word Tool — Word & Character Counter Online" description="Count words, characters, sentences & paragraphs instantly. Free word counter with reading time, readability score, keyword frequency & Lorem Ipsum generator." jsonLd={[appSchema, faqSchema]}>
  <WordCounter heading="Free Word Tool — Word & Character Counter Online.">
  <div slot="below-textarea" class="mt-8">

  <!-- Writing Streak -->
  <section class="max-w-4xl mx-auto px-4 pb-8">
    <div class="p-5 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Writing Streak</h2>
        <span id="streak-last-edit" class="text-xs text-gray-400 dark:text-gray-500 italic">—</span>
      </div>
      <div class="flex items-stretch gap-4 mb-4">
        <div class="flex-1 text-center">
          <div id="streak-count" class="text-3xl font-bold text-gray-900 dark:text-white">0</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">day streak</div>
        </div>
        <div class="w-px bg-gray-200 dark:bg-gray-700 self-stretch"></div>
        <div class="flex-1 text-center">
          <div id="streak-today" class="text-3xl font-bold text-gray-900 dark:text-white">0</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">words today</div>
        </div>
        <div class="w-px bg-gray-200 dark:bg-gray-700 self-stretch"></div>
        <div class="flex-1 text-center">
          <div id="streak-week" class="text-3xl font-bold text-gray-900 dark:text-white">0</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">this week</div>
        </div>
      </div>
      <div id="streak-dots" class="flex gap-2 justify-center mb-3"></div>
      <p id="streak-msg" class="text-xs font-medium text-center text-blue-600 dark:text-blue-400 min-h-[1rem]"></p>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="max-w-4xl mx-auto px-4 pt-2 pb-10">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-1">Who is Free Word Tool for?</h2>
    <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">A free, private, instant writing toolkit — built for anyone who works with words.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

      <div class="flex gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <span class="text-2xl flex-shrink-0">📱</span>
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">Social Media Managers &amp; Content Creators</h3>
          <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Hit platform character limits for Twitter/X, LinkedIn, and Instagram captions without guessing.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <span class="text-2xl flex-shrink-0">✍️</span>
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">Writers, Authors &amp; Bloggers</h3>
          <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Track word count targets, estimate reading time, and analyse sentence variety across drafts.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <span class="text-2xl flex-shrink-0">🔍</span>
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">SEO Specialists &amp; Marketers</h3>
          <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Check meta description length, measure content depth, and surface keyword frequency at a glance.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <span class="text-2xl flex-shrink-0">🎓</span>
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">Students &amp; Academics</h3>
          <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Meet essay word counts, check assignment length, and convert words to pages before submitting.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <span class="text-2xl flex-shrink-0">🎤</span>
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">Public Speakers &amp; Presenters</h3>
          <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Use speaking-time estimates to rehearse scripts and nail your talk within its allotted slot.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <span class="text-2xl flex-shrink-0">🔒</span>
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">Privacy-Conscious Users</h3>
          <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Everything runs in your browser — your text is never uploaded, stored, or seen by any server.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Frequently Asked Questions</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8">Everything you need to know about using Free Word Tool.</p>
    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="group border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" open={i === 0}>
          <summary class="flex items-center justify-between p-5 cursor-pointer bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors list-none">
            <span class="font-medium text-gray-900 dark:text-white pr-4">{faq.q}</span>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-5 pb-5 pt-3 bg-white dark:bg-gray-950 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </section>

  </div>
  </WordCounter>

  <!-- Footer -->
  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 py-8 sm:py-6 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:gap-3 sm:text-left text-sm text-gray-500 dark:text-gray-400">
      <div><a href="/" class="font-semibold text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Free Word Tool</a><span class="mx-2 text-gray-300 dark:text-gray-600">&middot;</span>&copy; 2026 <a href="https://www.builtbyswami.com/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">BuiltbySwami</a>. All rights reserved.</div>
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
        <a href="/contact-us" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contact Us</a>
      </nav>
    </div>
  </footer>
</Layout>
