---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';

const platforms = [
  { name: 'Email Subject',   limit: 60,   label: 'Subject line'   },
  { name: 'TikTok Bio',      limit: 80,   label: 'Bio'            },
  { name: 'Meta Description',limit: 160,  label: 'SEO snippet'    },
  { name: 'Twitter / X',     limit: 280,  label: 'Post'           },
  { name: 'Pinterest',       limit: 500,  label: 'Pin description'},
  { name: 'Instagram',       limit: 2200, label: 'Caption'        },
  { name: 'Threads',         limit: 500,  label: 'Post'           },
  { name: 'LinkedIn',        limit: 3000, label: 'Post'           },
  { name: 'YouTube',         limit: 5000, label: 'Description'    },
];

const faqs = [
  {
    q: "Does this character counter include spaces?",
    a: "Yes — the Characters stat counts every character including spaces. The No Spaces stat counts only non-whitespace characters. Both update in real time as you type or paste."
  },
  {
    q: "What is Twitter's character limit?",
    a: "Twitter / X allows up to 280 characters per post. URLs are counted as 23 characters regardless of their actual length. Use the Twitter (280) limit preset in the tool to track compliance."
  },
  {
    q: "How many characters should a Meta description be?",
    a: "Google typically displays 150–160 characters in search results. Anything longer gets truncated. Use the Meta Description (160) preset to stay within the safe range."
  },
  {
    q: "Does punctuation count as a character?",
    a: "Yes. Every letter, number, space, punctuation mark, and symbol counts as one character. Emojis can count as 1 or 2 characters depending on the platform encoding."
  },
  {
    q: "Is there a character limit on this tool?",
    a: "No — the tool handles any amount of text, from a single tweet to a full manuscript. The limit presets are optional overlays to help you track compliance with a specific platform."
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<Layout
  title="Character Counter — Count Characters Online Free"
  description="Free online character counter. Instantly count characters with and without spaces. Set platform limits for Twitter, LinkedIn, Meta descriptions, Instagram, and more."
  jsonLd={[faqSchema]}
>
  <WordCounter heading="Character Counter — Count Characters Instantly.">
    <div slot="below-textarea" class="mt-8">

      <!-- Platform limits grid -->
      <section class="max-w-4xl mx-auto px-4 pb-10">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-1">Character limits by platform</h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">Click any card to set that limit in the tool above.</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {platforms.map(({ name, limit, label }) => (
            <button
              data-set-limit={limit}
              class="platform-card group flex flex-col gap-1.5 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 hover:border-blue-400 dark:hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-950 transition-colors text-left"
            >
              <span class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide">{label}</span>
              <span class="text-sm font-semibold text-gray-800 dark:text-white group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors leading-tight">{name}</span>
              <span class="text-2xl font-bold text-gray-900 dark:text-white tabular-nums">{limit.toLocaleString()}</span>
              <span class="text-xs text-blue-600 dark:text-blue-400 font-medium opacity-0 group-hover:opacity-100 transition-opacity mt-0.5">Set limit →</span>
            </button>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section class="max-w-4xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Frequently Asked Questions</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8">Common questions about counting characters online.</p>
        <div class="space-y-4">
          {faqs.map((faq, i) => (
            <details class="group border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" open={i === 0}>
              <summary class="flex items-center justify-between p-5 cursor-pointer bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors list-none">
                <span class="font-medium text-gray-900 dark:text-white pr-4">{faq.q}</span>
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-5 pb-5 pt-3 bg-white dark:bg-gray-950 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </section>

    </div>
  </WordCounter>

  <script is:inline>
    // Platform cards → click the matching limit-btn in the tool
    document.querySelectorAll('.platform-card').forEach(card => {
      card.addEventListener('click', () => {
        const limit = card.dataset.setLimit;
        const btn = document.querySelector(`.limit-btn[data-limit="${limit}"]`);
        if (btn) {
          btn.click();
          document.querySelector('#text-input')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Visually promote the Characters stat as the lead metric on this page
    const charsCard = document.getElementById('stat-chars')?.closest('.stat-card');
    const wordsCard = document.getElementById('stat-words')?.closest('.stat-card');
    if (charsCard && wordsCard) {
      const grid = charsCard.parentElement;
      grid.insertBefore(charsCard, wordsCard);
    }
  </script>

  <!-- Footer -->
  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-auto">
    <div class="max-w-7xl mx-auto px-4 py-8 sm:py-6 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:gap-3 sm:text-left text-sm text-gray-500 dark:text-gray-400">
      <div><a href="/" class="font-semibold text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Free Word Tool</a></div>
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
        
      </nav>
    </div>
  </footer>
</Layout>
