---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';
---

<Layout
  title="Character Counter — Count Characters Online Free"
  description="Free online character counter. Count characters with and without spaces, track character limits for Twitter, LinkedIn, and Meta descriptions instantly."
>
  <WordCounter heading="Character Counter" />

  <!-- Brief intro for SEO -->
  <section class="max-w-4xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3">About This Character Counter</h2>
    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-4">
      This free character counter tool lets you count characters in real time with or without spaces. Use the character limit presets to check if your text fits within Twitter's 280-character limit, a Meta description's 160-character limit, or LinkedIn's 3,000-character post limit.
    </p>
    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
      All analysis happens entirely in your browser — your text is never sent to a server. The tool also provides word count, sentence count, paragraph count, and estimated reading and speaking times.
    </p>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-auto">
    <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 <a href="https://www.builtbyswami.com/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">BuiltbySwami</a>. All rights reserved.</p>
      <nav class="flex gap-4 flex-wrap justify-center">
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
      </nav>
    </div>
  </footer>
</Layout>
