---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Privacy Policy — Free Word Tool"
  description="Privacy policy for Free Word Tool. Your text is never collected or stored. Learn how we use cookies, Google Analytics, and consent management."
>
  <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-blue-600" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="4" width="28" height="24" rx="3" fill="currentColor" opacity="0.15"/>
          <rect x="6" y="9" width="12" height="2" rx="1" fill="currentColor"/>
          <rect x="6" y="14" width="20" height="2" rx="1" fill="currentColor"/>
          <rect x="6" y="19" width="16" height="2" rx="1" fill="currentColor"/>
        </svg>
        <span class="font-bold text-xl text-blue-600 group-hover:text-blue-700 transition-colors">Free Word Tool</span>
      </a>
      <nav class="hidden md:flex items-center gap-4 ml-4 text-sm">
        <a href="/character-counter" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
      </nav>
      <div class="flex items-center gap-2">
        <button id="theme-toggle" aria-label="Toggle dark mode" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
          <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.07-.71.71M6.34 17.66l-.71.71m12.73 0-.71-.71M6.34 6.34l-.71-.71M12 5a7 7 0 1 1 0 14A7 7 0 0 1 12 5z"/></svg>
          <svg class="w-5 h-5 block dark:hidden text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
        </button>
        <button id="mobile-menu-btn" aria-label="Toggle menu" class="md:hidden p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
          <svg id="hamburger-icon" class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-5 h-5 text-gray-600 dark:text-gray-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
      <nav class="flex flex-col px-4 py-3 gap-1 text-sm">
        <a href="/" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Free Word Tool</a>
        <a href="/character-counter" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Features</a>
      </nav>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Privacy Policy</h1>
    <p class="text-gray-500 dark:text-gray-400 text-sm mb-8">Last updated: June 16, 2026</p>

    <div class="prose prose-gray dark:prose-invert max-w-none space-y-8 text-gray-700 dark:text-gray-300 leading-relaxed">

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">1. Overview</h2>
        <p>Free Word Tool ("we," "our," or "the tool") is a free, client-side text analysis tool. We are committed to protecting your privacy. This policy explains what data we collect, how we use it, and your rights.</p>
        <p class="mt-2 font-medium text-blue-700 dark:text-blue-400">Short version: Your text is never collected, stored, or transmitted. We do use Google Analytics (via Google Tag Manager) to understand site traffic, and a cookie consent tool to let you control that.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">2. Your Text Data</h2>
        <p>All text you type or paste into Free Word Tool is processed entirely within your web browser using JavaScript. No text is ever sent to our servers (we don't have application servers), stored in a database, logged, or shared with any third party. When you close or navigate away from the page, the text is gone.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">3. Cookies & Local Storage</h2>
        <p>We use <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded text-sm">localStorage</code> to save your dark/light mode preference and your draft text on this device. This data stays on your device and is never sent anywhere.</p>
        <p class="mt-2">We also use cookies for two purposes:</p>
        <ul class="list-disc pl-6 mt-2 space-y-1">
          <li><strong>Consent management:</strong> CookieHub sets a cookie to remember your cookie consent choices so we don't ask you again on every visit.</li>
          <li><strong>Analytics:</strong> if you consent, Google Analytics (loaded via Google Tag Manager) sets cookies (such as <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded text-sm">_ga</code> and <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded text-sm">_ga_*</code>) to distinguish visitors and sessions. See Section 4 for details.</li>
        </ul>
        <p class="mt-2">We do not use advertising cookies or social media tracking pixels.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">4. Analytics &amp; Cookie Consent</h2>
        <p>We use <strong>Google Tag Manager</strong> to load <strong>Google Analytics (GA4)</strong> on this site, which helps us understand how visitors use Free Word Tool — for example, which pages are popular and how visitors navigate the site. Google Analytics may collect information such as your approximate location (derived from IP address), device and browser type, pages visited, and time spent on the site. It does not have access to any text you type into the tool.</p>
        <p class="mt-2">This data is processed by Google in accordance with the <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">Google Privacy Policy</a>. We do not combine this data with any other information to personally identify you.</p>
        <p class="mt-2">We use <strong>CookieHub</strong> as our cookie consent management platform. On your first visit, you are shown a consent banner where you can <strong>allow all cookies</strong>, <strong>deny all non-essential cookies</strong>, or adjust settings for individual categories. Analytics cookies are only set if you give consent. You can change your preference at any time by clearing your browser's cookies for this site, which will show the consent banner again on your next visit.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">5. Third-Party Services</h2>
        <p>Free Word Tool uses the following third-party services:</p>
        <ul class="list-disc pl-6 mt-2 space-y-1">
          <li><strong>Google Tag Manager &amp; Google Analytics (Google LLC)</strong> — site usage analytics, subject to your cookie consent choice (see Section 4).</li>
          <li><strong>CookieHub</strong> — cookie consent management.</li>
        </ul>
        <p class="mt-2">We do not embed third-party advertising or social media tracking pixels. We do not sell or rent any data to third parties.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">6. Your Rights &amp; Choices</h2>
        <p>Depending on your location, you may have rights under data protection laws (such as the GDPR or CCPA), including the right to access, correct, or delete personal data we hold about you, and the right to withdraw analytics consent at any time. Because we do not collect personally identifiable information beyond what Google Analytics processes on our behalf, most requests can be satisfied by clearing cookies for this site or using your browser's "Do Not Track" / ad-blocking settings, which will prevent analytics cookies from being set.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7. Children's Privacy</h2>
        <p>Free Word Tool is a general-purpose utility suitable for all ages. We do not knowingly collect personal information from anyone, including children under the age of 13.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">8. Changes to This Policy</h2>
        <p>We may update this privacy policy occasionally, including to reflect changes to the third-party services we use. Changes will be reflected on this page with an updated date. We encourage you to review this policy periodically.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">9. Contact</h2>
        <p>If you have questions about this privacy policy or how your data is handled, please reach out via the <a href="/contact-us" class="text-blue-600 dark:text-blue-400 hover:underline">contact information</a> on our site.</p>
      </section>
    </div>
  </main>

  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-12">
    <div class="max-w-7xl mx-auto px-4 py-8 sm:py-6 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:gap-3 sm:text-left text-sm text-gray-500 dark:text-gray-400">
      <div><a href="/" class="font-semibold text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Free Word Tool</a></div>
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/lorem-ipsum-generator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Lorem Ipsum</a>
        <a href="/features" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
      </nav>
    </div>
  </footer>

  <script>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      const menu = document.getElementById('mobile-menu');
      const burger = document.getElementById('hamburger-icon');
      const close  = document.getElementById('close-icon');
      menu?.classList.toggle('hidden');
      burger?.classList.toggle('hidden');
      close?.classList.toggle('hidden');
    });

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>
</Layout>
