---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "How many pages is 1,000 words?",
    a: "1,000 words is approximately 4 pages when double-spaced at 12pt font, or 2 pages when single-spaced. These figures assume standard 1-inch margins and Times New Roman or Arial 12pt."
  },
  {
    q: "How many pages is 2,000 words?",
    a: "2,000 words is approximately 8 pages double-spaced or 4 pages single-spaced at 12pt. A typical college essay of 2,000 words runs about 8 double-spaced pages."
  },
  {
    q: "How many pages is 500 words?",
    a: "500 words is approximately 2 pages double-spaced or 1 page single-spaced at 12pt font with standard margins."
  },
  {
    q: "How many pages is 5,000 words?",
    a: "5,000 words is approximately 20 pages double-spaced or 10 pages single-spaced. This is equivalent to a medium-length research paper or a short chapter in a book."
  },
  {
    q: "Does font size affect page count?",
    a: "Yes significantly. At 10pt font, you fit roughly 20–25% more words per page compared to 12pt. At 14pt, you fit fewer words. 12pt is the academic standard for most essays and reports."
  },
  {
    q: "How many words are on a standard double-spaced page?",
    a: "A standard double-spaced page at 12pt Times New Roman with 1-inch margins holds approximately 250–275 words. This calculator uses 250 words per page as the standard estimate."
  },
  {
    q: "How many pages is a 10,000 word essay?",
    a: "10,000 words is approximately 40 pages double-spaced or 20 pages single-spaced. This length is typical for a graduate thesis chapter or a long academic research paper."
  },
  {
    q: "What is 1.5 line spacing in word count per page?",
    a: "At 1.5 line spacing, a 12pt page holds approximately 333 words — midway between single-spaced (500 words) and double-spaced (250 words). This spacing is common in business reports and theses."
  }
];

const referenceRows = [
  { words: 250,   single: '½',  half: '¾',  double: 1   },
  { words: 500,   single: 1,    half: 1.5,  double: 2   },
  { words: 1000,  single: 2,    half: 3,    double: 4   },
  { words: 1500,  single: 3,    half: 4.5,  double: 6   },
  { words: 2000,  single: 4,    half: 6,    double: 8   },
  { words: 2500,  single: 5,    half: 7.5,  double: 10  },
  { words: 5000,  single: 10,   half: 15,   double: 20  },
  { words: 7500,  single: 15,   half: 22.5, double: 30  },
  { words: 10000, single: 20,   half: 30,   double: 40  },
];
---

<Layout
  title="Words to Pages Calculator — How Many Pages Is My Word Count?"
  description="Convert word count to pages instantly. See how many pages 500, 1000, 2000, or 5000 words is at single, 1.5, or double spacing with 12pt font."
>
  <!-- Header -->
  <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <svg class="w-8 h-8 text-blue-600" viewBox="0 0 32 32" fill="currentColor">
            <rect x="2" y="4" width="28" height="24" rx="3" fill="currentColor" opacity="0.15"/>
            <rect x="6" y="9" width="12" height="2" rx="1" fill="currentColor"/>
            <rect x="6" y="14" width="20" height="2" rx="1" fill="currentColor"/>
            <rect x="6" y="19" width="16" height="2" rx="1" fill="currentColor"/>
          </svg>
          <span class="font-bold text-xl text-blue-600 group-hover:text-blue-700 transition-colors">WordCount</span>
        </a>
        <nav class="hidden sm:flex items-center gap-4 ml-4 text-sm">
          <a href="/" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Word Counter</a>
          <a href="/character-counter" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
          <a href="/words-to-pages" class="text-blue-600 dark:text-blue-400 font-medium">Words to Pages</a>
          <a href="/reading-time-calculator" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        </nav>
      </div>
      <button id="theme-toggle" aria-label="Toggle dark mode" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
        <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.07-.71.71M6.34 17.66l-.71.71m12.73 0-.71-.71M6.34 6.34l-.71-.71M12 5a7 7 0 1 1 0 14A7 7 0 0 1 12 5z"/></svg>
        <svg class="w-5 h-5 block dark:hidden text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
      </button>
    </div>
  </header>

  <!-- Hero -->
  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-900 dark:to-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Words to Pages Calculator</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-2 text-sm max-w-xl">Enter your word count, choose font size and line spacing to instantly find out how many pages your document will be.</p>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 py-10">

    <!-- Calculator Card -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 p-6 mb-10 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Calculate Pages</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1.5 uppercase tracking-wide">Word Count</label>
          <input
            id="wtp-words"
            type="number"
            min="1"
            placeholder="e.g. 1500"
            class="w-full px-3 py-2.5 rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1.5 uppercase tracking-wide">Font Size</label>
          <select id="wtp-font" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:outline-none focus:border-blue-500 transition-colors">
            <option value="10">10pt</option>
            <option value="11">11pt</option>
            <option value="12" selected>12pt (standard)</option>
            <option value="14">14pt</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1.5 uppercase tracking-wide">Line Spacing</label>
          <select id="wtp-spacing" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:outline-none focus:border-blue-500 transition-colors">
            <option value="single">Single spaced</option>
            <option value="half">1.5 spaced</option>
            <option value="double" selected>Double spaced</option>
          </select>
        </div>
      </div>

      <!-- Result -->
      <div id="wtp-result" class="hidden rounded-xl bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 p-5 text-center">
        <p class="text-sm text-blue-700 dark:text-blue-300 mb-1">Estimated page count</p>
        <p id="wtp-pages" class="text-5xl font-bold text-blue-600 dark:text-blue-400">—</p>
        <p id="wtp-pages-label" class="text-sm text-blue-600 dark:text-blue-300 mt-1">pages</p>
        <p id="wtp-detail" class="text-xs text-blue-500 dark:text-blue-400 mt-2"></p>
      </div>
      <div id="wtp-placeholder" class="rounded-xl bg-gray-50 dark:bg-gray-800 border border-dashed border-gray-300 dark:border-gray-600 p-5 text-center text-sm text-gray-400 dark:text-gray-500">
        Enter a word count above to see your page estimate
      </div>
    </div>

    <!-- Reference Table -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Word Count to Pages — Reference Table</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">All estimates use 12pt font with standard 1-inch margins.</p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
              <th class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Word Count</th>
              <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">Single Spaced</th>
              <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">1.5 Spaced</th>
              <th class="px-4 py-3 text-center font-semibold text-gray-700 dark:text-gray-300">Double Spaced</th>
            </tr>
          </thead>
          <tbody>
            {referenceRows.map((row, i) => (
              <tr class={`border-b border-gray-100 dark:border-gray-800 ${i % 2 === 0 ? 'bg-white dark:bg-gray-900' : 'bg-gray-50/50 dark:bg-gray-800/40'}`}>
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{row.words.toLocaleString()} words</td>
                <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.single} {typeof row.single === 'number' && row.single !== 1 ? 'pages' : 'page'}</td>
                <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.half} pages</td>
                <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">{row.double} pages</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Frequently Asked Questions</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">Common questions about converting word counts to page counts.</p>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" open={i === 0}>
            <summary class="flex items-center justify-between p-5 cursor-pointer bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors list-none">
              <span class="font-medium text-gray-900 dark:text-white pr-4">{faq.q}</span>
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-3 bg-white dark:bg-gray-950 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-12">
    <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 BuiltbySwami. All rights reserved.</p>
      <nav class="flex gap-4 flex-wrap justify-center">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Word Counter</a>
        <a href="/character-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Character Counter</a>
        <a href="/words-to-pages" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Words to Pages</a>
        <a href="/reading-time-calculator" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reading Time</a>
        <a href="/essay-word-counter" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Essay Counter</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Privacy</a>
      </nav>
    </div>
  </footer>

  <script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    // Words per page base values at 12pt
    const BASE: Record<string, number> = { single: 500, half: 333, double: 250 };
    // Font size multipliers relative to 12pt
    const FONT_MULT: Record<string, number> = { '10': 1.25, '11': 1.1, '12': 1, '14': 0.82 };

    function calculate() {
      const words   = parseInt((document.getElementById('wtp-words') as HTMLInputElement).value, 10);
      const font    = (document.getElementById('wtp-font') as HTMLSelectElement).value;
      const spacing = (document.getElementById('wtp-spacing') as HTMLSelectElement).value;

      const result  = document.getElementById('wtp-result')!;
      const ph      = document.getElementById('wtp-placeholder')!;

      if (!words || words <= 0) {
        result.classList.add('hidden');
        ph.classList.remove('hidden');
        return;
      }

      const wpp   = BASE[spacing] * FONT_MULT[font];
      const pages = words / wpp;
      const label = pages < 1 ? `${Math.round(pages * 10) / 10}` : pages % 1 === 0 ? String(pages) : pages.toFixed(1);
      const spacingLabel = spacing === 'single' ? 'single-spaced' : spacing === 'half' ? '1.5-spaced' : 'double-spaced';

      document.getElementById('wtp-pages')!.textContent = label;
      document.getElementById('wtp-pages-label')!.textContent = parseFloat(label) === 1 ? 'page' : 'pages';
      document.getElementById('wtp-detail')!.textContent = `${words.toLocaleString()} words · ${font}pt font · ${spacingLabel} · ~${Math.round(wpp)} words/page`;

      result.classList.remove('hidden');
      ph.classList.add('hidden');
    }

    document.getElementById('wtp-words')?.addEventListener('input', calculate);
    document.getElementById('wtp-font')?.addEventListener('change', calculate);
    document.getElementById('wtp-spacing')?.addEventListener('change', calculate);
  </script>
</Layout>
